	-- E. TWEEN TELEPORTATION CONTROLLER
	local activeTween = nil
	
	local function teleportToCoord(cframeValue)
	    if activeTween then
	        activeTween:Cancel()
	        activeTween = nil
	    end
	
	    local character = localPlayer.Character
	    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	    local hrp = character.HumanoidRootPart
	
	    -- Parse coordinate values
	    local coords = {}
	    for num in string.gmatch(cframeValue, "[%-?%d%.]+") do
	        table.insert(coords, tonumber(num))
	    end
	    if #coords < 3 then return end
	    
	    local targetPos = Vector3.new(coords[1], coords[2], coords[3])
	    local targetCFrame = CFrame.new(targetPos)
	    if #coords >= 12 then
	        targetCFrame = CFrame.new(unpack(coords))
	    end
	
	    -- Get settings parameters
	    local speed = tonumber(pages.Page_Settings.TweenSpeedCard.Input.Text) or 365
	    local boostDist = tonumber(pages.Page_Settings.TweenBoostDistCard.Input.Text) or 400
	
	    local currentPos = hrp.Position
	    local distance = (currentPos - targetPos).Magnitude
	
	    -- Visual pulse for starting teleport
	    statusLabel.Text = "TELEPORT"
	    statusDot.BackgroundColor3 = Color3.fromRGB(244, 63, 94) -- red pulse
	
	    -- Disable physics on all parts
	    local partsToRestore = {}
	    for _, desc in ipairs(character:GetDescendants()) do
	        if desc:IsA("BasePart") then
	            if desc.CanCollide then
	                desc.CanCollide = false
	                table.insert(partsToRestore, desc)
	            end
	        end
	    end
	    local humanoid = character:FindFirstChildOfClass("Humanoid")
	    if humanoid then
	        humanoid.PlatformStand = true
	        humanoid.AutoRotate = false
	    end
	    hrp.Anchored = true
	
	    -- If distance is short, warp instantly
	    if distance < 15 then
	        hrp.CFrame = targetCFrame
	        statusLabel.Text = "ACTIVE"
	        statusDot.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
	        for _, part in ipairs(partsToRestore) do
	            pcall(function() part.CanCollide = true end)
	        end
	        if humanoid then
	            humanoid.PlatformStand = false
	            humanoid.AutoRotate = true
	        end
	        hrp.Anchored = false
	        return
	    end
	
	    local duration = distance / speed
	    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
	    activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
	
	    activeTween.Completed:Connect(function(playbackState)
	        statusLabel.Text = "ACTIVE"
	        statusDot.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
	        for _, part in ipairs(partsToRestore) do
	            pcall(function() part.CanCollide = true end)
	        end
	        if humanoid then
	            humanoid.PlatformStand = false
	            humanoid.AutoRotate = true
	        end
	        hrp.Anchored = false
	        activeTween = nil
	    end)
	
	    activeTween:Play()
	end
	
	local function stopTeleport()
	    if activeTween then
	        activeTween:Cancel()
	        activeTween = nil
	        playSound(0.85)
	        local character = localPlayer.Character
	        if character then
	            local hrp = character:FindFirstChild("HumanoidRootPart")
	            if hrp then hrp.Anchored = false end
	            local humanoid = character:FindFirstChildOfClass("Humanoid")
	            if humanoid then
	                humanoid.PlatformStand = false
	                humanoid.AutoRotate = true
	            end
	            for _, desc in ipairs(character:GetDescendants()) do
	                if desc:IsA("BasePart") then
	                    pcall(function() desc.CanCollide = true end)
	                end
	            end
	        end
	        statusLabel.Text = "ACTIVE"
	        statusDot.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
	        print("Teleport Tween Stopped.")
	    end
	end
	
