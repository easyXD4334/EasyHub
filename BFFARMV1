	-- Set up farm toggles and farming loop logic
	local farmingNearest = false
	local farmingCake = false
	local bringMobsRunning = false
	
	local function bringMobsStep(targetHRP, bringMobDist)
	    local enemiesFolder = workspace:FindFirstChild("Enemies")
	    local list = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()
	    for _, other in ipairs(list) do
	        if other:IsA("Model") and other:FindFirstChild("Humanoid") and other:FindFirstChild("HumanoidRootPart") then
	            if not Players:GetPlayerFromCharacter(other) and other.Humanoid.Health > 0 then
	                local otherHRP = other.HumanoidRootPart
	                local otherDist = (targetHRP.Position - otherHRP.Position).Magnitude
	                if otherDist <= bringMobDist and otherDist > 3 then
	                    local dir = (targetHRP.Position - otherHRP.Position).Unit
	                    local step = math.min(15, otherDist - 3)
	                    local newPos = otherHRP.Position + dir * step
	                    other:PivotTo(CFrame.new(newPos, targetHRP.Position))
	                end
	            end
	        end
	    end
	end
	
	local function startBringMobs(targetHRP, bringMobDist)
	    if bringMobsRunning then return end
	    bringMobsRunning = true
	    task.spawn(function()
	        while bringMobsRunning do
	            bringMobsStep(targetHRP, bringMobDist)
	            task.wait(tonumber(pages.Page_Settings.BringMobDelayCard.Input.Text) or 0.1)
	        end
	    end)
	end
	
	local function stopBringMobs()
	    bringMobsRunning = false
	end
	
	local function getNearestMob()
	    local nearest = nil
	    local nearestDist = math.huge
	    local character = localPlayer.Character
	    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	    local myPos = character.HumanoidRootPart.Position
	
	    local enemiesFolder = workspace:FindFirstChild("Enemies")
	    local list = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()
	
	    for _, child in ipairs(list) do
	        if child:IsA("Model") and child:FindFirstChild("Humanoid") and child:FindFirstChild("HumanoidRootPart") then
	            if not Players:GetPlayerFromCharacter(child) and child.Humanoid.Health > 0 then
	                local dist = (myPos - child.HumanoidRootPart.Position).Magnitude
	                if dist < nearestDist then
	                    nearestDist = dist
	                    nearest = child
	                end
	            end
	        end
	    end
	    return nearest
	end
	
	local function getCakePrinceMob()
	    local nearest = nil
	    local nearestDist = math.huge
	    local character = localPlayer.Character
	    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	    local myPos = character.HumanoidRootPart.Position
	
	    local enemiesFolder = workspace:FindFirstChild("Enemies")
	    local list = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()
	
	    for _, child in ipairs(list) do
	        if child:IsA("Model") and child:FindFirstChild("Humanoid") and child:FindFirstChild("HumanoidRootPart") then
	            if string.find(string.lower(child.Name), "cake") or string.find(string.lower(child.Name), "prince") then
	                if child.Humanoid.Health > 0 then
	                    local dist = (myPos - child.HumanoidRootPart.Position).Magnitude
	                    if dist < nearestDist then
	                        nearestDist = dist
	                        nearest = child
	                    end
	                end
	            end
	        end
	    end
	    return nearest or getNearestMob()
	end
	
	-- Tween-based movement for mob farming (matches reference script style)
	local farmTweenCoroutine = nil
	local farmTweenCancelFlag = false
	
	local function stopFarmTween()
	    farmTweenCancelFlag = true
	    farmTweenCoroutine = nil
	end
	
	local function moveCharacterToMob(character, targetPosition)
	    stopFarmTween()
	    farmTweenCancelFlag = false
	
	    local function tweenFunc()
	        local hrp = character:FindFirstChild("HumanoidRootPart")
	        if not hrp then return end
	        local humanoid = character:FindFirstChildOfClass("Humanoid")
	        hrp.Anchored = true
	        if humanoid then
	            humanoid.PlatformStand = true
	            humanoid.AutoRotate = false
	        end
	
	        local partsToRestore = {}
	        for _, desc in ipairs(character:GetDescendants()) do
	            if desc:IsA("BasePart") and desc.CanCollide then
	                desc.CanCollide = false
	                table.insert(partsToRestore, desc)
	            end
	        end
	
	        while true do
	            if farmTweenCancelFlag then break end
	            if not character.Parent then break end
	
	            hrp = character:FindFirstChild("HumanoidRootPart")
	            if not hrp then break end
	
	            -- Read speed settings each tick so changes take effect immediately
	            local speed = tonumber(pages.Page_Settings.TweenSpeedCard.Input.Text) or 365
	            local boostDist = tonumber(pages.Page_Settings.TweenBoostDistCard.Input.Text) or 400
	            local boostedSpeed = speed * 1.5
	
	            local currentPos = hrp.Position
	            local distanceToTarget = (targetPosition - currentPos).Magnitude
	            local currentSpeed = distanceToTarget < boostDist and boostedSpeed or speed
	
	            local dt = task.wait()
	
	            -- Close enough: snap and stop — translate only
	            if distanceToTarget < currentSpeed * dt then
	                character:PivotTo(character:GetPivot() + (targetPosition - currentPos))
	                break
	            end
	
	            -- Step toward target, translate only — no rotation change
	            local step = currentSpeed * dt
	            local moveVec = (targetPosition - currentPos).Unit * step
	            local newPos = currentPos + moveVec
	            character:PivotTo(character:GetPivot() + (newPos - currentPos))
	        end
	
	        for _, part in ipairs(partsToRestore) do
	            pcall(function() part.CanCollide = true end)
	        end
	        if humanoid then
	            humanoid.PlatformStand = false
	            humanoid.AutoRotate = true
	        end
	
	        farmTweenCoroutine = nil
	    end
	
	    farmTweenCoroutine = coroutine.create(tweenFunc)
	    coroutine.resume(farmTweenCoroutine)
	end
	
	task.spawn(function()
	    while true do
	        if farmingNearest or farmingCake then
	            local target = nil
	            if farmingCake then
	                target = getCakePrinceMob()
	            else
	                target = getNearestMob()
	            end
	
	            local character = localPlayer.Character
	            if target and character and character:FindFirstChild("HumanoidRootPart") then
	                local hrp = character.HumanoidRootPart
	                local targetHRP = target:FindFirstChild("HumanoidRootPart")
	
	                if targetHRP then
	                    local bringMobDist = tonumber(pages.Page_Settings.BringMobDistCard.Input.Text) or 400
	                    local mobDist = tonumber(pages.Page_Settings.DistanceFromMobCard.Input.Text) or 15
	                    local dist = (hrp.Position - targetHRP.Position).Magnitude
	                    local dir = dist > 0.01 and (hrp.Position - targetHRP.Position).Unit or Vector3.new(0, 0, -1)
	                    local flatDir = Vector3.new(dir.X, 0, dir.Z).Unit
	                    local targetPos = targetHRP.Position + flatDir * mobDist + Vector3.new(0, mobDist, 0)
	                    if dist > mobDist * 1.5 then
	                        -- Launch tween coroutine toward mob if not already running
	                        if farmTweenCoroutine == nil then
	                            stopBringMobs()
	                            moveCharacterToMob(character, targetPos)
	                        end
	                    else
	                        -- Arrived: stop tween, wait, then re-tween
	                        stopFarmTween()
	                        hrp.Anchored = true
	                        local humanoid = character:FindFirstChildOfClass("Humanoid")
	                        if humanoid then
	                            humanoid.PlatformStand = true
	                            humanoid.AutoRotate = false
	                        end
	                        for _, desc in ipairs(character:GetDescendants()) do
	                            if desc:IsA("BasePart") then
	                                desc.CanCollide = false
	                            end
	                        end
	                        hrp.CFrame = CFrame.new(targetPos) * (hrp.CFrame - hrp.CFrame.Position)
	
	                        startBringMobs(targetHRP, bringMobDist)
	
	                        local activeTool = character:FindFirstChildOfClass("Tool")
	                        if activeTool then
	                            activeTool:Activate()
	                        end
	
	                        task.wait(tonumber(pages.Page_Settings.ArrivalDelayCard.Input.Text) or 0.1)
	                    end
	                else
	                    stopFarmTween()
	                    stopBringMobs()
	                    hrp.Anchored = false
	                    local humanoid = character:FindFirstChildOfClass("Humanoid")
	                    if humanoid then
	                        humanoid.PlatformStand = false
	                        humanoid.AutoRotate = true
	                    end
	                end
	            else
	                stopFarmTween()
	                stopBringMobs()
	                if character and character:FindFirstChild("HumanoidRootPart") then
	                    character.HumanoidRootPart.Anchored = false
	                    local humanoid = character:FindFirstChildOfClass("Humanoid")
	                    if humanoid then
	                        humanoid.PlatformStand = false
	                        humanoid.AutoRotate = true
	                    end
	                end
	            end
	        else
	            stopFarmTween()
	            stopBringMobs()
	            local character = localPlayer.Character
	            if character and character:FindFirstChild("HumanoidRootPart") then
	                if character.HumanoidRootPart.Anchored then
	                    character.HumanoidRootPart.Anchored = false
	                end
	                local humanoid = character:FindFirstChildOfClass("Humanoid")
	                if humanoid then
	                    humanoid.PlatformStand = false
	                    humanoid.AutoRotate = true
	                end
	            end
	        end
	        task.wait()
	    end
	end)
	
