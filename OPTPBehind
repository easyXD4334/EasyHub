-- ==========================================
-- UI UPDATE FUNCTIONS
-- ==========================================
local function updateModeButton()
	if isToggleMode then
		modeButton.Text = "Mode: Toggle"
		modeButton.BackgroundColor3 = Color3.fromRGB(150, 70, 70)
	else
		modeButton.Text = "Mode: Hold"
		modeButton.BackgroundColor3 = Color3.fromRGB(70, 70, 150)
	end
end

local function updateTPButtonVisual()
	if not tpButton.Visible then return end
	if isHoldingZ then
		tpButton.BackgroundColor3 = TP_BUTTON_ACTIVE_COLOR
		tpButton.Text = "TP ON"
	else
		tpButton.BackgroundColor3 = TP_BUTTON_INACTIVE_COLOR
		tpButton.Text = "TP"
	end
end

local playerButtons = {}

local function updatePlayerListColors()
	for plr, btn in pairs(playerButtons) do
		if plr == selectedPlayer then
			btn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
			btn.Text = ">> " .. plr.Name
		else
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			btn.Text = plr.Name
		end
	end
end

local function updatePlayerList()
	for _, btn in pairs(playerButtons) do
		btn:Destroy()
	end
	playerButtons = {}

	local order = 1
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -8, 0, 24)
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			btn.Text = plr.Name
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = smallFontSize
			btn.TextTruncate = Enum.TextTruncate.AtEnd
			btn.LayoutOrder = order
			btn.Parent = scrollFrame

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = btn

			playerButtons[plr] = btn
			order = order + 1

			btn.MouseButton1Click:Connect(function()
				if selectedPlayer == plr then
					selectedPlayer = nil
				else
					selectedPlayer = plr
				end
				updatePlayerListColors()
			end)
		end
	end
	updatePlayerListColors()
end

updateModeButton()
updatePlayerList()

Players.PlayerAdded:Connect(function()
	task.wait(0.1)
	updatePlayerList()
end)

-- ==========================================
-- DRAGGING LOGIC
-- ==========================================
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ==========================================
-- MODE BUTTON CLICK
-- ==========================================
modeButton.MouseButton1Click:Connect(function()
	isToggleMode = not isToggleMode
	if not isToggleMode then
		isHoldingZ = false
	end
	updateModeButton()
	updateTPButtonVisual()
end)

-- ==========================================
-- LOCK BUTTON CLICK
-- ==========================================
lockButton.MouseButton1Click:Connect(function()
	if isLocked then
		isLocked = false
		lockedPlayer = nil
	else
		if nearestPlayer then
			lockedPlayer = nearestPlayer
			isLocked = true
		end
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	if lockedPlayer == plr then
		lockedPlayer = nil
		isLocked = false
	end
	if selectedPlayer == plr then
		selectedPlayer = nil
	end
	updatePlayerList()
end)

-- ==========================================
-- MOBILE TP BUTTON INPUT
-- ==========================================
-- Hold mode: press activates, release deactivates
-- Toggle mode: tap toggles on/off
tpButton.MouseButton1Down:Connect(function()
	if isToggleMode then
		isHoldingZ = not isHoldingZ
	else
		isHoldingZ = true
		tpButtonHeld = true
	end
	updateTPButtonVisual()
end)

tpButton.MouseButton1Up:Connect(function()
	if not isToggleMode then
		isHoldingZ = false
		tpButtonHeld = false
	end
	updateTPButtonVisual()
end)

-- Global touch release safety net: if finger slides off the button
-- in hold mode, we still deactivate when they lift their finger
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch and tpButtonHeld then
		if not isToggleMode then
			isHoldingZ = false
			tpButtonHeld = false
			updateTPButtonVisual()
		end
	end
end)

-- ==========================================
-- KEYBOARD INPUT (Desktop)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then return end
	if input.KeyCode == Enum.KeyCode.Z then
		if isToggleMode then
			isHoldingZ = not isHoldingZ
		else
			isHoldingZ = true
		end
		updateTPButtonVisual()
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessedEvent)
	if input.KeyCode == Enum.KeyCode.Z then
		if not isToggleMode then
			isHoldingZ = false
			updateTPButtonVisual()
		end
	end
end)

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function()
	local character = player.Character
	local currentNearest = nil
	local shortestDistance = math.huge

	if character and character.PrimaryPart then
		for _, otherPlayer in ipairs(Players:GetPlayers()) do
			if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character.PrimaryPart then
				local distance = (otherPlayer.Character.PrimaryPart.Position - character.PrimaryPart.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					currentNearest = otherPlayer
				end
			end
		end
	end
	nearestPlayer = currentNearest

	-- Update Lock Button UI
	local newText = ""
	local newColor = Color3.new(1, 1, 1)

	if isLocked and lockedPlayer and lockedPlayer.Parent then
		newText = "Unlock: " .. lockedPlayer.Name
		newColor = Color3.fromRGB(50, 150, 50)
	elseif nearestPlayer then
		newText = "Lock: " .. nearestPlayer.Name
		newColor = Color3.fromRGB(200, 50, 50)
	else
		newText = "No Players Nearby"
		newColor = Color3.fromRGB(100, 100, 100)
	end

	if lockButton.Text ~= newText then
		lockButton.Text = newText
		lockButton.BackgroundColor3 = newColor
	end

	-- Execute Teleportation
	if isHoldingZ and character and character.PrimaryPart then
		local targetPlayer = nil

		if selectedPlayer and selectedPlayer.Parent and selectedPlayer.Character and selectedPlayer.Character.PrimaryPart then
			targetPlayer = selectedPlayer
		elseif isLocked and lockedPlayer and lockedPlayer.Parent then
			targetPlayer = lockedPlayer
		elseif nearestPlayer then
			targetPlayer = nearestPlayer
		end

		if targetPlayer and targetPlayer.Character and targetPlayer.Character.PrimaryPart then
			local targetRoot = targetPlayer.Character.PrimaryPart
			local look = targetRoot.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local offset = flatLook.Magnitude > 0 and flatLook.Unit * DISTANCE or Vector3.new(0, 0, DISTANCE)

			character:PivotTo(targetRoot.CFrame - offset)
		end
	end
end)
